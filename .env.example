# ==============================================================================
# Known Issues & Status Page Configuration
# ==============================================================================

# Application Branding and Public URL
# Important for reverse proxy setup (Traefik, Cloudflare Tunnel, Nginx Proxy Manager).
# Do not leave as localhost in production!
APP_NAME=Smart Home Known Issues
APP_URL=https://status.example.com

# Security & Session Settings
# Generate a secure 64+ char random string using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-in-production
SESSION_COOKIE_NAME=known_issues_session
# Set COOKIE_SECURE=true when running behind HTTPS (recommended)
COOKIE_SECURE=true

# Database Configuration (PostgreSQL in Docker Compose)
POSTGRES_DB=known_issues_db
POSTGRES_USER=known_issues
POSTGRES_PASSWORD=generate_a_strong_database_password_here

# When running standalone without Docker Compose, you can use SQLite:
# DATABASE_URL=sqlite:///./data/known_issues.db

# Initial Admin Credentials (auto-provisioned on first launch if not existing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_immediately!

# SMTP Configuration for Double Opt-in & Notification Emails
# If left empty, outgoing emails are captured in an internal memory log for testing
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@status.example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@status.example.com
SMTP_TLS=true

# Initial Data Seeding
# Automatically populates realistic sample issues & devices if the database is empty
AUTO_SEED=true
